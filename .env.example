# =============================================================================
# ICNV Cerâmica — variáveis de ambiente
# Copie para .env e preencha. Nunca commite o .env real.
# No EasyPanel: configure como Environment Variables do app.
# =============================================================================

# --- Aplicação ---
# URL pública do site (sem barra no final). Ex: https://icnvceramica.com.br
APP_URL=http://localhost:3000

# Ambiente: development | production
NODE_ENV=production

# Porta do servidor Node (EasyPanel costuma injetar PORT)
PORT=3000

# Segredo para assinar cookies de sessão (gere com: openssl rand -hex 32)
SESSION_SECRET=troque-por-uma-string-aleatoria-de-pelo-menos-32-caracteres

# Segredo auxiliar para tokens JWT de reset de senha (gere outro: openssl rand -hex 32)
JWT_SECRET=troque-por-outra-string-aleatoria-de-pelo-menos-32-caracteres

# Algoritmo de hash de senha (fixo — não altere em produção sem migração)
PASSWORD_HASH_ALGORITHM=argon2id

# --- Banco de dados MySQL ---
# Crie o banco manualmente no painel do MySQL / EasyPanel e informe aqui.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=icnv
DB_PASSWORD=senha-forte-do-banco
DB_NAME=icnv
# Opcional: conexão via socket (deixa DB_HOST vazio se usar)
# DB_SOCKET=

# --- Upload de arquivos ---
# Diretório absoluto ou relativo onde as imagens enviadas serão gravadas.
# No EasyPanel, monte um volume persistente neste caminho.
UPLOAD_DIR=./uploads
# Tamanho máximo em bytes (padrão 5 MB)
UPLOAD_MAX_BYTES=5242880

# --- reCAPTCHA (opcional) ---
# Se ambas as chaves existirem, o captcha aparece no login, "esqueci senha" e formulários públicos.
# Se estiverem vazias, o captcha fica completamente oculto.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Mesmas chaves podem ser usadas em todos os fluxos, ou separe se preferir:
# RECAPTCHA_LOGIN_SITE_KEY=
# RECAPTCHA_LOGIN_SECRET_KEY=
# RECAPTCHA_FORGOT_PASSWORD_SITE_KEY=
# RECAPTCHA_FORGOT_PASSWORD_SECRET_KEY=

# --- Web Push (VAPID) ---
# Gere com: npx web-push generate-vapid-keys
# A chave privada NUNCA deve ir para o frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@icnvceramica.com.br

# =============================================================================
# NÃO coloque aqui:
# - SMTP (host, user, senha) → configurado no painel Admin → Configurações
# - GTM ID → configurado no painel Admin → Configurações
# - Logo / cores → configurados no painel
# =============================================================================

# =============================================================================
# Docker Compose (opcional — local / VPS)
# =============================================================================
# MYSQL_ROOT_PASSWORD=root_troque_esta_senha
# MYSQL_PUBLISH_PORT=3306
# APP_PUBLISH_PORT=3000
# No compose, DB_HOST=db (nome do serviço). No EasyPanel, use o hostname interno do MySQL.
